    "@codemirror/lang-yaml": "^6.1.3",
    "@codemirror/language": "^6.12.4",
    "@codemirror/legacy-modes": "^6.5.4",
    "@codemirror/view": "^6.43.13",
    "@dashglass/datasource-prometheus": "workspace:*",
    "@dashglass/grafana-import": "workspace:*",
    "@dashglass/model": "workspace:*",
    "@dashglass/panels-builtin": "workspace:*",
    "@dashglass/promql-editor": "workspace:*",
    "@dashglass/runtime": "workspace:*",
    "@dashglass/ui": "workspace:*",
    "@emotion/react": "^11.14.0",
    "@tanstack/react-query": "^5.103.2",
    "@uiw/react-codemirror": "^4.25.11",

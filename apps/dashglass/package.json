{
  "name": "dashglass",
  "version": "0.1.0",
  "license": "Apache-2.0",
  "private": true,
  "description": "Dashglass open-source app shell",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
